# Reseeti — Production environment variables
#
# One consolidated reference for every environment variable across all
# 27 stages, organized by service instead of by stage number — the
# per-stage .env.local.example additions are still accurate, this file
# just saves you from hunting through 27 READMEs to assemble a full
# production configuration in one place.
#
# Copy this to .env.local for local dev, or paste the equivalent values
# into Vercel → Project Settings → Environment Variables for production.
# Every var marked REQUIRED must be set for the app to function at all;
# everything else activates a specific feature and fails gracefully
# (a clear "not configured" message, not a crash) when left unset.

# =========================================================================
# CORE — REQUIRED for the app to run at all
# =========================================================================

# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Project Settings > API > service_role (secret). SERVER-ONLY — this key
# bypasses Row Level Security entirely. Never expose it to the browser,
# never commit it, never put it in a NEXT_PUBLIC_ var.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Your real production domain. Several features build absolute URLs from
# this directly (OAuth redirect URIs, invoice share links sent by SMS/
# WhatsApp/email, the cron-generated reminder links) — get this right
# before registering any OAuth app or webhook below, since those have to
# match it exactly.
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Any long random string — generate with: openssl rand -hex 32
# Vercel automatically sends this as a Bearer token on cron-triggered
# requests once it's set as an env var; it's what stops your cron routes
# (reminders, backups, subscription-expiry checks) from being callable
# by anyone who finds the URL.
CRON_SECRET=

# Any long random string — generate with: openssl rand -hex 32
# Encrypts cloud-backup OAuth tokens (Google/Dropbox/OneDrive) at rest.
ENCRYPTION_KEY=

# Any long random string — generate with: openssl rand -hex 32
# Signs the security hash shown on receipts and the /verify/{code} page.
# Changing it later only affects hashes generated after the change.
RECEIPT_SIGNING_SECRET=

# =========================================================================
# SMS (Twilio) — required for SMS reminders and login alerts
# =========================================================================
# console.twilio.com. Separate from phone-login OTP, which is configured
# entirely inside the Supabase dashboard (Authentication > Providers >
# Phone) — this is for the app SENDING its own SMS (reminders, login
# alerts), which needs its own Twilio credentials.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# =========================================================================
# EMAIL (Resend) — required for "Email invoice" and feedback notifications
# =========================================================================
# resend.com/api-keys. RESEND_FROM_EMAIL must be on a domain verified in
# Resend's Domains tab — a plain Gmail/Yahoo address won't work.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=invoices@yourbusiness.com

# Where in-app feedback/bug reports get emailed, in addition to being
# stored in the `feedback` table.
FEEDBACK_NOTIFICATION_EMAIL=

# =========================================================================
# PAYMENTS — at least one recommended; Paystack is the only one with
# true auto-recurring subscriptions
# =========================================================================

# Paystack dashboard > Settings > API Keys & Webhooks. Use test keys
# until you've verified the full flow, then switch to live keys.
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxx
# The plan_code for your Pro subscription plan — create this in the
# Paystack dashboard under Plans first.
PAYSTACK_PRO_PLAN_CODE=PLN_xxxxxxxxxxxx

# OPay merchant dashboard > API Keys & Webhooks. No true recurring
# billing — this is a "pay again each period" flow; Reseeti's 7-day
# grace period is what makes that survivable rather than a hard cutoff.
OPAY_MERCHANT_ID=256xxxxxxxxxxxxx
OPAY_PUBLIC_KEY=OPAYPUBxxxxxxxxxxxxx
OPAY_SECRET_KEY=OPAYPRVxxxxxxxxxxxxx
OPAY_ENV=live

# Monnify dashboard > Settings > API Keys, and Settings > Contracts Setup
# for the contract code. Same no-true-recurring caveat as OPay.
MONNIFY_API_KEY=MK_PROD_xxxxxxxxxxxx
MONNIFY_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MONNIFY_CONTRACT_CODE=xxxxxxxxxx
MONNIFY_ENV=live

# =========================================================================
# WHATSAPP — optional, powers automated WhatsApp reminders
# =========================================================================
# developers.facebook.com — WhatsApp product on a Meta Business App, plus
# a message template APPROVED in Meta Business Manager (WhatsApp requires
# a pre-approved template for any business-initiated message outside a
# 24-hour customer-reply window — see README_STAGE24.md).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_REMINDER_TEMPLATE_NAME=invoice_reminder

# =========================================================================
# AI FEATURES — optional, powers Invoice Assistant / Business Insights /
# Expense Categorization
# =========================================================================
# aistudio.google.com/apikey — Google's free tier needs no credit card.
# Server-only, never exposed to the browser. See README_STAGE22.md for
# provider tradeoffs.
GEMINI_API_KEY=
# Optional overrides if the default model names in lib/ai.js ever get
# retired or renamed. Leave unset to use the defaults.
# GEMINI_MODEL_FAST=
# GEMINI_MODEL_REASONING=

# =========================================================================
# CLOUD BACKUP OAUTH — optional, each independent of the others
# =========================================================================
# Each needs a redirect URI registered EXACTLY as:
#   {NEXT_PUBLIC_APP_URL}/api/backup/{provider}/callback
# Get NEXT_PUBLIC_APP_URL finalized before registering any of these.

# console.cloud.google.com — OAuth 2.0 Client ID, type "Web application"
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# dropbox.com/developers/apps — Scoped access, Full Dropbox,
# files.content.write scope enabled
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# portal.azure.com — Azure AD app registration, "Accounts in any
# organizational directory and personal Microsoft accounts",
# Files.ReadWrite + offline_access delegated permissions
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=

# =========================================================================
# ERROR MONITORING (Sentry) — recommended
# =========================================================================
# sentry.io — create a project (platform: Next.js). DSN from
# Settings > Client Keys; auth token from Settings > Auth Tokens, scoped
# to project:releases (needed for source map upload at build time).
# NEXT_PUBLIC_SENTRY_DSN is the same value as SENTRY_DSN, duplicated with
# the NEXT_PUBLIC_ prefix so it also reaches the browser bundle.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# =========================================================================
# AUTOMATED DATABASE BACKUPS — optional (recommended)
# =========================================================================
# Name of a PRIVATE Supabase Storage bucket for the daily platform-wide
# database export cron — create this bucket before enabling the cron.
# Defaults to "platform-backups" if unset. This is a logical export
# SUPPLEMENTING Supabase's own built-in backups, not replacing them —
# turn those on too, in Project Settings > Database > Backups.
DATABASE_BACKUP_BUCKET=platform-backups

# =========================================================================
# E2E TESTING (Playwright) — optional, only needed to run the test suite
# =========================================================================
# Not consumed by the running app itself — only by `npm run test:e2e`.
# See e2e/README.md. Requires a Supabase "test phone number" configured
# in Authentication > Providers > Phone with a fixed OTP code.
# E2E_TEST_PHONE=+2348000000000
# E2E_TEST_OTP=123456
# E2E_TEST_INVOICE_ID=
# E2E_BASE_URL=https://yourdomain.com

# =========================================================================
# SUPABASE STORAGE BUCKETS TO CREATE MANUALLY (not env vars, listed here
# so nothing gets missed — all PRIVATE except where noted)
# =========================================================================
# - logos                  (business logo uploads)
# - platform-backups       (Stage 27 automated DB backup — name must match
#                            DATABASE_BACKUP_BUCKET above)
# - feedback-screenshots   (Stage 27 in-app feedback)
